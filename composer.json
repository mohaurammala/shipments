{
  "name": "mohaurammala/shipments",
  "description": "Shipment booking workflow against the Shiplogic sandbox API (Fastway Couriers technical assessment).",
  "type": "project",
  "license": "Apache-2.0",
  "require": {
    "php": "^8.5",
    "guzzlehttp/guzzle": "^8.6",
    "vlucas/phpdotenv": "^5.8",
    "ext-pdo_mysql": "*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    },
    "files": [
      "src/Core/helpers.php"
    ]
  },
  "config": {
    "sort-packages": true
  },
  "require-dev": {
    "phpunit/phpunit": "^13.4"
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  }
}
