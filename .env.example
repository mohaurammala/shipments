# Copy to .env and fill in real values. Never commit .env.

# Application
APP_ENV=sandbox
APP_DEBUG=false
APP_HTTPS=false
APP_URL=http://localhost:8080

# Database (DB_HOST is the compose service name, not localhost)
DB_HOST=db
DB_PORT=3306
DB_DATABASE=fastway
DB_USERNAME=fastway
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
DB_TEST_DATABASE=fastway_test

# Shiplogic sandbox API (credentials are supplied separately)
SHIPLOGIC_BASE_URL=https://api.shiplogic.com
SHIPLOGIC_API_KEY=replace-with-sandbox-key
SHIPLOGIC_CONNECT_TIMEOUT=5
SHIPLOGIC_TIMEOUT=20

# Booking workflow
QUOTE_TTL_MINUTES=30
